
import os
import uuid

from fastapi import APIRouter, UploadFile, File, HTTPException
from app.datasets.processor import process_engine_dataset

router = APIRouter(
    prefix="/api/datasets",
    tags=["Datasets"]
)

UPLOAD_DIR = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "../../../datasets/raw")
)

os.makedirs(UPLOAD_DIR, exist_ok=True)


@router.post("/upload")
async def upload_dataset(file: UploadFile = File(...)):

    if not file.filename or not file.filename.lower().endswith(".csv"):
        raise HTTPException(status_code=400, detail="Only CSV files are supported.")

    file_path = os.path.join(UPLOAD_DIR, f"{uuid.uuid4().hex}.csv")

    try:
        content = await file.read()

        if not content:
            raise HTTPException(status_code=400, detail="The uploaded file is empty.")

        if len(content) > 10 * 1024 * 1024:
            raise HTTPException(status_code=413, detail="Maximum upload size is 10 MB.")

        with open(file_path, "wb") as uploaded_file:
            uploaded_file.write(content)

        result = process_engine_dataset(file_path)

        return {
            "message": "Dataset uploaded and processed successfully.",
            "filename": file.filename,
            "records": result["total_records"],
            "rpm_min": result["rpm_min"],
            "rpm_max": result["rpm_max"],
            "peak_torque_nm": result["peak_torque_nm"],
            "peak_power_kw": result["peak_power_kw"],
            "data": result["data"]
        }

    except HTTPException:
        if os.path.exists(file_path):
            os.remove(file_path)
        raise

    except ValueError as error:
        if os.path.exists(file_path):
            os.remove(file_path)
        raise HTTPException(status_code=400, detail=str(error))

    except Exception:
        if os.path.exists(file_path):
            os.remove(file_path)
        raise HTTPException(status_code=500, detail="Dataset processing failed.")

@router.post("/compare")
async def compare_engine_datasets(
    engine_a: UploadFile = File(...),
    engine_b: UploadFile = File(...)
):
    temp_files = []

    try:
        datasets = []

        for uploaded_file in [engine_a, engine_b]:

            if not uploaded_file.filename or not uploaded_file.filename.lower().endswith(".csv"):
                raise HTTPException(
                    status_code=400,
                    detail="Both files must be CSV files."
                )

            content = await uploaded_file.read()

            if not content:
                raise HTTPException(
                    status_code=400,
                    detail="An uploaded CSV is empty."
                )

            if len(content) > 10 * 1024 * 1024:
                raise HTTPException(
                    status_code=413,
                    detail="Maximum upload size is 10 MB."
                )

            temp_path = os.path.join(
                UPLOAD_DIR,
                f"{uuid.uuid4().hex}_compare.csv"
            )

            temp_files.append(temp_path)

            with open(temp_path, "wb") as temp_file:
                temp_file.write(content)

            result = process_engine_dataset(temp_path)
            datasets.append(result["data"])

        data_a, data_b = datasets

        def metrics(data):
            peak_torque = max(data, key=lambda x: x["torque_nm"])
            peak_power = max(data, key=lambda x: x["power_kw"])

            return {
                "records": len(data),
                "rpm_min": min(x["rpm"] for x in data),
                "rpm_max": max(x["rpm"] for x in data),
                "peak_torque_nm": peak_torque["torque_nm"],
                "peak_torque_rpm": peak_torque["rpm"],
                "peak_power_kw": peak_power["power_kw"],
                "peak_power_rpm": peak_power["rpm"]
            }

        metrics_a = metrics(data_a)
        metrics_b = metrics(data_b)

        def difference(a, b):
            if a == 0:
                return None
            return round(((b - a) / a) * 100, 2)

        return {
            "message": "Engine datasets compared successfully.",
            "engine_a": {
                "metrics": metrics_a,
                "data": data_a
            },
            "engine_b": {
                "metrics": metrics_b,
                "data": data_b
            },
            "comparison": {
                "peak_torque_difference_percent": difference(
                    metrics_a["peak_torque_nm"],
                    metrics_b["peak_torque_nm"]
                ),
                "peak_power_difference_percent": difference(
                    metrics_a["peak_power_kw"],
                    metrics_b["peak_power_kw"]
                )
            }
        }

    except HTTPException:
        raise

    except ValueError as error:
        raise HTTPException(status_code=400, detail=str(error))

    except Exception:
        raise HTTPException(
            status_code=500,
            detail="Engine comparison failed."
        )

    finally:
        for path in temp_files:
            if os.path.exists(path):
                os.remove(path)


@router.post("/analyze")
async def analyze_engine_dataset(file: UploadFile = File(...)):
    temp_path = None

    try:
        content = await read_csv_upload(file)

        with tempfile.NamedTemporaryFile(
            mode="wb",
            suffix=".csv",
            delete=False
        ) as temp_file:
            temp_file.write(content)
            temp_path = temp_file.name

        result = process_engine_dataset(temp_path)
        data = result["data"]

        if not data:
            raise ValueError("No valid engine measurements found.")

        torque_values = [row["torque_nm"] for row in data]
        power_values = [row["power_kw"] for row in data]

        peak_torque = max(data, key=lambda row: row["torque_nm"])
        peak_power = max(data, key=lambda row: row["power_kw"])

        highest_rpm = max(data, key=lambda row: row["rpm"])

        torque_drop = (
            (peak_torque["torque_nm"] - highest_rpm["torque_nm"])
            / peak_torque["torque_nm"]
        ) * 100

        return {
            "message": "Advanced engine analysis completed.",
            "metrics": {
                "records": len(data),
                "average_torque_nm": round(
                    sum(torque_values) / len(torque_values), 2
                ),
                "average_power_kw": round(
                    sum(power_values) / len(power_values), 2
                ),
                "peak_torque_nm": peak_torque["torque_nm"],
                "peak_torque_rpm": peak_torque["rpm"],
                "peak_power_kw": peak_power["power_kw"],
                "peak_power_rpm": peak_power["rpm"],
                "torque_range_nm": round(
                    max(torque_values) - min(torque_values), 2
                ),
                "power_range_kw": round(
                    max(power_values) - min(power_values), 2
                ),
                "torque_drop_at_max_rpm_percent": round(
                    torque_drop, 2
                ),
                "rpm_range": {
                    "minimum": min(row["rpm"] for row in data),
                    "maximum": highest_rpm["rpm"]
                }
            },
            "data": data
        }

    except HTTPException:
        raise
    except ValueError as error:
        raise HTTPException(status_code=400, detail=str(error))
    except Exception:
        raise HTTPException(
            status_code=500,
            detail="Advanced engine analysis failed."
        )
    finally:
        if temp_path and os.path.exists(temp_path):
            os.remove(temp_path)

